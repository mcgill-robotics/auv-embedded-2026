	(text "VIO controls the SPI logic voltage \nand can be switched from +3v3 to +5v for convenience"
		(exclude_from_sim no)
		(at 205.994 37.846 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0493ac13-b747-48cd-88f7-704e81f39748")
	)
	(text "Vcc is 5V\n"
		(exclude_from_sim no)
		(at 71.628 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3d85fe91-c1e4-45a9-9f2b-ccd47fa04716")
	)
	(text "SPI interface\n"
		(exclude_from_sim no)
		(at 204.47 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ac4637a-502e-4616-ad15-72423c65a930")
	)
	(text "ADA4807s are used as precision voltage follower to feed the REF voltage into the AD4001. \nThe REF sets the Differential analog input range which spans ±VREF V.\nAccording to the datasheet Vref can take a value from 2.4 V to 5.1 V. "
		(exclude_from_sim no)
		(at 92.71 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9a4bf23c-8b5f-4f1f-9ae3-dc916fb95d87")
	)
	(text "3.3V and 1.8V LDOs "
		(exclude_from_sim no)
		(at 90.424 129.794 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b6f7f4d3-d458-47f0-a0bb-63182e3161de")
	)
	(text "AD4001 is the ADC chip, it samples\nthe signal over SPI to the Teensy. \nC6 and C7 are decoupling capacitors, should be placed close to the IC"
		(exclude_from_sim no)
		(at 169.164 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c9cb8cf3-f248-46c7-8837-4d0d35907d83")
	)
	(text "mid-supply reference (VCC/2) for Vocm \nand ADC reference through voltage buffer\n"
		(exclude_from_sim no)
		(at 99.06 176.022 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d50ab0c3-ab94-40d6-bfa6-0f7905c789d6")
	)
	(text "2.5V voltage regulator\n"
		(exclude_from_sim no)
		(at 34.798 170.688 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e144c3bd-7b47-4f30-b477-dca32ef3b5ed")
	)
