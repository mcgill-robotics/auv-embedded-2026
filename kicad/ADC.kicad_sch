	(text "VIO controls the SPI logic voltage \nand can be switched from +3v3 to +5v for convenience"
		(exclude_from_sim no)
		(at 239.014 63.246 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0493ac13-b747-48cd-88f7-704e81f39748")
	)
	(text "Vcc is 5V\n"
		(exclude_from_sim no)
		(at 107.188 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0eeb79d9-f922-47e6-9dc0-cbe9e28a2256")
	)
	(text "(From datasheet) Connect *SHDWN pin at the load and route with a wide metal trace\nto minimize load regulation errors. This pin sinks 2mA"
		(exclude_from_sim no)
		(at 91.948 213.868 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "14271c46-dc8c-47f4-8a09-87578e930a32")
	)
	(text "SPI interface\n"
		(exclude_from_sim no)
		(at 237.49 92.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ac4637a-502e-4616-ad15-72423c65a930")
	)
	(text "tying Vin_N to Vout+ will generate symetric power rails. \nThe pump charge's positive and negative output voltages will be +/- 10V respectively.\n\nSince the boost charge pump generates 2*Vin_p on Vout+ and that the negative charge pump will also generate -Vout+ then the two charge pump outputs are +/-10V now"
		(exclude_from_sim no)
		(at 316.738 170.688 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "94c11980-0a29-483c-8f5c-6c2e4762be05")
	)
	(text "Equation for feedback network : V(LDO) = 1.2 * (R1/R2 + 1)"
		(exclude_from_sim no)
		(at 357.124 111.252 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "977db3d9-c1d3-441a-a530-db2368965003")
	)
	(text "ADA4807s are used as precision voltage follower to feed the REF voltage into the AD4001. \nThe REF sets the Differential analog input range which spans ±VREF V.\nAccording to the datasheet Vref can take a value from 2.4 V to 5.1 V. "
		(exclude_from_sim no)
		(at 125.73 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9a4bf23c-8b5f-4f1f-9ae3-dc916fb95d87")
	)
	(text "3.3V and 1.8V LDOs "
		(exclude_from_sim no)
		(at 123.444 155.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b6f7f4d3-d458-47f0-a0bb-63182e3161de")
	)
	(text "AD4001 is the ADC chip, it samples\nthe signal over SPI to the Teensy. \nC6 and C7 are decoupling capacitors, should be placed close to the IC"
		(exclude_from_sim no)
		(at 202.184 55.372 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c9cb8cf3-f248-46c7-8837-4d0d35907d83")
	)
