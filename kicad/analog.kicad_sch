	(text "ADC Driver's role in the signal chain \n\nSecond Order LPF\nUnity gain (for signal conditioning)"
		(exclude_from_sim no)
		(at 347.218 123.698 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "13b7a95b-99cb-42a9-bbf8-4aab35f773a3")
	)
	(text "An FDA's FB is connected to its inputs \nin a closed loop manner\nSo FB+ => IN- \nAnd FB- => IN+\n"
		(exclude_from_sim no)
		(at 287.782 77.216 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1d2d0327-53d7-47bf-b4b6-f4f45bfb7f66")
	)
	(text "+OUT and -OUT of the driver must be fed back to the opposite-sense feedback input \nso that the loop is negative feedback\n\nAlso note that +FB is internally connected to +OUT, and -FB is connected to -OUT"
		(exclude_from_sim no)
		(at 319.278 155.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "72c4f4da-fed3-4e02-b6de-bf7ae7078c4b")
	)
	(text "ADC settling/kickback filter"
		(exclude_from_sim no)
		(at 358.14 104.902 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7eb3db8b-77aa-4549-8636-30b6668975df")
	)
	(text "Gain selection (Teensy GPIO)\n"
		(exclude_from_sim no)
		(at 155.702 129.794 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9d6d44f9-02a6-4cc5-9048-4281bac7d4ff")
	)
	(text "DC input bias current return"
		(exclude_from_sim no)
		(at 142.24 174.498 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a0bceeea-8eec-4d15-a47f-e58e78bbec9f")
	)
	(text "Differential gain of x10\n\nWhat about termination / impedance matching ? \n\nDO THE THEVENIN EEQUIVALENT RESISTOR THING !!!"
		(exclude_from_sim no)
		(at 187.706 118.872 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 30 0 1)
			)
		)
		(uuid "a18e824f-6d26-4da5-8f91-2383969742aa")
	)
	(text "Because the source hydrophone is low impedance \nonly one bias current return R is needed, \nbut I give the possibility to add two in case\n\nWhen using two Rs, make sure to keep a very low source imabalance \nas this could severely affect CMRRR"
		(exclude_from_sim no)
		(at 95.25 180.086 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ac66dbfc-acf7-420b-a224-0bbcbfc1f494")
	)
	(text "Coaxial cable, to the hydrophone\n"
		(exclude_from_sim no)
		(at 245.11 75.184 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b5c21290-2ebe-48e7-81c9-7d5c9e4ec75f")
	)
	(text "Input RC filter to minimize RFI rectification\n"
		(exclude_from_sim no)
		(at 110.49 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "de9693d1-b416-48c6-bbaf-1dd80a427d77")
	)
	(text "The ADA4945 is a fully differential amplifier which sets a common mode voltage of 2.5V \nto make sure both IN- and IN+ at the AD4001 inputs are strictly positive"
		(exclude_from_sim no)
		(at 324.104 61.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ec53c934-1a53-4468-92c0-55ee59b15a6b")
	)
