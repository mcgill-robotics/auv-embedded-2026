	(text "The voltage ref. needs 0.3V headroom \nso need to power it with 5.3V !"
		(exclude_from_sim no)
		(at 171.704 52.324 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 30 28 1)
			)
		)
		(uuid "4cad88b0-65b9-46e5-a384-f5067f050a2d")
	)
	(text "mid-supply reference (VCC/2) for Vocm and ADC reference\n"
		(exclude_from_sim no)
		(at 251.46 99.568 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6278357b-8b48-40eb-9e42-7fd9b57f440c")
	)
	(text "Differential gain of x10\n\nWhat about termination / impedance matching ? "
		(exclude_from_sim no)
		(at 37.846 65.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c09aa2bb-ce8b-45f7-bd73-efddfa6e5944")
	)
	(text "The ADA4945 is a fully differential amplifier which sets a common mode voltage of 2.5V \nto make sure both IN- and IN+ at the AD4001 inputs are strictly positive"
		(exclude_from_sim no)
		(at 109.728 25.654 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c7feed5a-b20f-4dee-9f43-9979deb2c77d")
	)
	(text "AD4001 is the ADC chip, it samples\nthe signal over SPI to the Teensy. \nC6 and C7 are decoupling capacitors, should be placed close to the IC"
		(exclude_from_sim no)
		(at 240.538 21.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c9cb8cf3-f248-46c7-8837-4d0d35907d83")
	)
	(text "ADA4807s are used as precision voltage follower to feed the REF voltage into the AD4001. \nThe REF sets the Differential analog input range which spans ±VREF V.\nAccording to the datasheet Vref can take a value from 2.4 V to 5.1 V. "
		(exclude_from_sim no)
		(at 212.344 136.398 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e0bb8420-d05a-4f9e-84e2-6379a426963c")
	)
	(text "Coaxial cable, to the hydrophone\n"
		(exclude_from_sim no)
		(at 39.37 29.464 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fa965468-80c6-404a-8aa9-25777cf90e13")
	)
